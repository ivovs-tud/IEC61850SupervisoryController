{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "hardware-free-tests",
      "displayName": "Complete hardware-free test suite",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SC_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "vcpkg-hardware-free-tests",
      "displayName": "Hardware-free tests with vcpkg",
      "inherits": "hardware-free-tests",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "hardware-free-tests",
      "configurePreset": "hardware-free-tests",
      "configuration": "Debug"
    },
    {
      "name": "vcpkg-hardware-free-tests",
      "configurePreset": "vcpkg-hardware-free-tests",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "hardware-free-tests",
      "configurePreset": "hardware-free-tests",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vcpkg-hardware-free-tests",
      "configurePreset": "vcpkg-hardware-free-tests",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
